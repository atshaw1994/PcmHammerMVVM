<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PCMHammerAvalonia.ViewModels"
        xmlns:helpers="using:PCMHammerAvalonia.Helpers"
        x:Class="PCMHammerAvalonia.Views.DialogBoxes.PcmTypeSelectDialogBox"
        x:DataType="vm:PcmSelectViewModel"
        mc:Ignorable="d"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Title="PCM Type">

    <Window.Resources>
        <helpers:PcmTypeDisplayTextConverter x:Key="PcmTypeDisplayTextConverter"/>
    </Window.Resources>

    <Grid Margin="12" 
          ColumnDefinitions="Auto,Auto" 
          RowDefinitions="Auto,Auto,Auto">

        <Label Content="PCM Type:" 
               VerticalAlignment="Center" 
               Target="{Binding #PCMTypeComboBox}"/>
        
        <ComboBox x:Name="PCMTypeComboBox" 
                  Grid.Column="1" 
                  Margin="10,5" 
                  ItemsSource="{Binding PCMTypes}" 
                  SelectedItem="{Binding SelectedPCMType}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource PcmTypeDisplayTextConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Grid.Column="1" 
              Grid.Row="2" 
              Margin="10,5" 
              ColumnDefinitions="*,*">
            <Button x:Name="CancelButton" 
                    Content="Cancel" 
                    Margin="0,0,8,0" 
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    HotKey="Escape" 
                    Command="{Binding CloseCommand}"/>
            <Button x:Name="OkButton" 
                    Content="OK" 
                    Grid.Column="1" 
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    HotKey="Enter" 
                    Command="{Binding AcceptAndCloseCommand}"/>
        </Grid>
    </Grid>
</Window>