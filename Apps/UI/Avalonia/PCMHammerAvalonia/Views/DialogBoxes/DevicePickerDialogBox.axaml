<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PCMHammerAvalonia.ViewModels"
        x:Class="PCMHammerAvalonia.Views.DialogBoxes.DevicePickerDialogBox"
        x:DataType="vm:DevicePickerViewModel"
        mc:Ignorable="d"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Title="Select Device">

    <DockPanel>
        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" 
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="6,4">
            <TextBlock Text="{Binding StatusText}" 
                       HorizontalAlignment="Stretch"/>
        </Border>

        <!-- Main Body Content -->
        <StackPanel Margin="8" Spacing="8">
            <!-- Category Selection -->
            <HeaderedContentControl Header="Device Category">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="5">
                    <RadioButton x:Name="SerialDeviceRadioButton" 
                                 GroupName="DeviceCategory" 
                                 Content="Serial Device"
                                 IsChecked="{Binding IsSerialDeviceSelected, Mode=TwoWay}"/>
                    <RadioButton x:Name="J2534DeviceRadioButton" 
                                 GroupName="DeviceCategory" 
                                 Content="J2534 Device"
                                 IsChecked="{Binding IsJ2534DeviceSelected, Mode=TwoWay}"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- Serial Device Options -->
            <HeaderedContentControl Header="Serial Device Options" 
                                    IsEnabled="{Binding #SerialDeviceRadioButton.IsChecked}">
                <StackPanel Margin="5" Spacing="4">
                    <Label Content="Serial Port" 
                           Target="{Binding #SerialPortComboBox}"/>
                    <ComboBox x:Name="SerialPortComboBox" 
                              Margin="0,0,0,8"
                              ItemsSource="{Binding SerialPorts}" 
                              DisplayMemberBinding="{Binding PortName}"
                              SelectedItem="{Binding SerialPort}"/>
                    
                    <Label Content="Device Type" 
                           Target="{Binding #SerialDeviceTypeComboBox}"/>
                    <ComboBox x:Name="SerialDeviceTypeComboBox" 
                              ItemsSource="{Binding SerialDevices}" 
                              SelectedItem="{Binding SerialPortDeviceType}"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- J2534 Device Options -->
            <HeaderedContentControl Header="J2534 Device Options" 
                                    IsEnabled="{Binding #J2534DeviceRadioButton.IsChecked}">
                <StackPanel Margin="5" Spacing="4">
                    <Label Content="Device Type" 
                           Target="{Binding #J2534DeviceTypeComboBox}"/>
                    <ComboBox x:Name="J2534DeviceTypeComboBox" 
                              ItemsSource="{Binding J2534Devices}" 
                              SelectedItem="{Binding J2534DeviceType}"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- Options & Actions -->
            <CheckBox x:Name="Enable4xCommunication" 
                      Content="Enable 4x Communication" 
                      Margin="5,0,0,0"
                      IsChecked="{Binding Enable4xReadWrite}"/>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Spacing="5" 
                        Margin="0,10,0,0">
                <Button Content="Auto Detect" Width="120" Command="{Binding AutoDetectCommand}"/>
                <Button Content="Test"        Width="120" Command="{Binding TestCommand}"/>
                <Button Content="Cancel"      Width="120" Command="{Binding CancelCommand}" HotKey="Escape"/>
                <Button Content="OK"          Width="120" Command="{Binding AcceptCommand}" HotKey="Enter"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>