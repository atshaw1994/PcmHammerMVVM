<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PCMHammerAvalonia.ViewModels;assembly=PCMHammerAvalonia"
             xmlns:views="clr-namespace:PCMHammerAvalonia.Views;assembly=PCMHammerAvalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="360"
             x:Class="PCMHammerAvalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    <!-- Design-Time DataContext for Previewer -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DrawerPage IsGestureEnabled="True" DrawerPlacement="Right">
        <DrawerPage.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="avares://PCMHammerAvalonia/Assets/0411_256px.ico"
                        Width="48" Height="48"/>
                <TextBlock Text="PCMHammer" VerticalAlignment="Center"/>
            </StackPanel>
        </DrawerPage.Header>
        <DrawerPage.Drawer>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <views:SideBarMenu/>
            </ScrollViewer>
        </DrawerPage.Drawer>
        <TabbedPage TabPlacement="Bottom">
            <TabbedPage.Styles>
                <!-- Base / Unselected Tab Style -->
                <Style Selector="TabItem">
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Style>

                <!-- Selected Tab Style -->
                <Style Selector="TabItem:selected">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
                </Style>

                <!-- Hover / Pointer-Over State -->
                <Style Selector="TabItem:pointerover">
                    <!-- Interactive feedback tint -->
                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                </Style>

                <!-- Optional: Selected + Hover State (Prevents hover from overwriting selected style) -->
                <Style Selector="TabItem:selected:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
                </Style>
            </TabbedPage.Styles>
            <ContentPage Header="Results">
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        Margin="4">
                    <ScrollViewer x:Name="ResultsScrollViewer"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock x:Name="ResultsLogTextBox"
                                                Text="{Binding ResultsLog}"
                                                TextWrapping="Wrap" 
                                                FontFamily="Consolas"/>
                    </ScrollViewer>
                </Border>
            </ContentPage>
            <ContentPage Header="Help">
                <Border x:Name="HelpViewContainer"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        Margin="4"/>
            </ContentPage>
            <ContentPage Header="Credits">
                <Border x:Name="CreditsViewContainer"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        Margin="4"/>
            </ContentPage>
            <ContentPage Header="Debug">
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        Margin="4">
                    <ScrollViewer x:Name="DebugScrollViewer"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock x:Name="DebugLogTextBox"
                                                Text="{Binding DebugLog}"
                                                TextWrapping="Wrap" 
                                                FontFamily="Consolas"/>
                    </ScrollViewer>
                </Border>
            </ContentPage>
        </TabbedPage>
    </DrawerPage>
</UserControl>
